# ─── Application ──────────────────────────────────────────────
# Public base URL of the deployed app (used for absolute links in emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Content / copy (spec §10) ────────────────────────────────
# Where the Contact form routes. Do not hardcode in logic.
CONTACT_EMAIL=hello@foxandloom.com
# From-address for outbound contact-form email (provider permitting; Resend
# requires a verified sending domain). Falls back to CONTACT_EMAIL if unset.
CONTACT_FROM_EMAIL=hello@foxandloom.com

# ─── Sales Brief delivery (spec §8.1 email-dispatch, §10) ─────
# Recipient of the internal Sales Intelligence Brief. Do not hardcode in logic.
# Default/example: marcus@foxandloom.com
SALES_BRIEF_TO=marcus@foxandloom.com
# From-address used for outbound brief email (provider permitting).
SALES_BRIEF_FROM=briefs@foxandloom.com

# ─── Email provider (thin interface, §9.3) ────────────────────
# Provider: "console" (default, logs to server logs) | "resend"
EMAIL_PROVIDER=console
# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# ─── LLM (OpenRouter, OpenAI-compatible) ──────────────────────
# Already present in the build environment; required for the interview + synthesis.
OPENROUTER_API_KEY=
# Model for interview + synthesis. Default: openai/gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini

# ─── Security (spec §6) ───────────────────────────────────────
# Max scans per IP/session per hour (spec §3, implementer sets N; default 3).
RATE_LIMIT_PER_HOUR=3
# Scraper timeout (ms). Degrades gracefully on timeout (spec §7.1).
SCRAPER_TIMEOUT_MS=40000
# Data retention (spec §6.5)
RETENTION_SCRAPED_DAYS=90
RETENTION_PROSPECT_ANSWERS_DAYS=365

# ─── Scraper (§8.1 research-scraper) ─────────────────────────
# Optional override for the Playwright browsers path.
# PLAYWRIGHT_BROWSERS_PATH=
